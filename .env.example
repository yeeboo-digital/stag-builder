# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# --- Edition switch ---------------------------------------------------------
# off  → island only: guided wizard + templates, no key, $0 (default)
# on   → also enables the AI-assist free-form box (requires a key below)
NEXT_PUBLIC_AI_MODE=off

# --- AI mode only (ignored when NEXT_PUBLIC_AI_MODE=off) --------------------
# Required when AI mode is on. Server-side only, never exposed to the browser.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the model. Defaults to Haiku 4.5 (cheapest tier).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Usage safeguard (AI mode, optional) -----------------------------------
# Global generation caps — a backstop beneath the Anthropic console's hard
# $20/month spend cap. Defaults: 200/day, 2500/month (≈ $20 on Haiku).
# MAX_GEN_PER_DAY=200
# MAX_GEN_PER_MONTH=2500
#
# For an accurate cap across serverless instances, point it at a shared store.
# Vercel KV (Storage tab auto-injects these) OR Upstash Redis REST:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Without these the cap falls back to best-effort in-memory (resets on cold start).

# Optional: Your deployed site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=https://s-tags.yeeboodigital.com
